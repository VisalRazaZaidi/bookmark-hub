{
  "manifest_version": 3,
  "name": "Bookmark Hub",
  "version": "1.1.0",
  "description": "All your bookmarks in one fast, searchable page. Click the toolbar icon to open it in a new tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Bookmark Hub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "scripts": [
      "js/background.js"
    ]
  },
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open Bookmark Hub"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-hub@visalraza.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
